// ---------------- scoring ----------------
function clamp(v,lo,hi){return Math.max(lo,Math.min(hi,v));}

function computeScore(){
  let score=0, used=0;
  if(data.gift!==null){ const c = WEIGHTS.gift * clamp(data.gift/15,-1,1); score+=c; used+=WEIGHTS.gift; }
  if(data.preopen!==null){ const c = WEIGHTS.preopen * clamp(data.preopen/0.5,-1,1); score+=c; used+=WEIGHTS.preopen; }
  if(data.us!==null){ const c = WEIGHTS.us * clamp(data.us/1.0,-1,1); score+=c; used+=WEIGHTS.us; }
  if(data.asia!==null){ const c = WEIGHTS.asia * clamp(data.asia/1.0,-1,1); score+=c; used+=WEIGHTS.asia; }
  if(data.fx!==null){ const c = WEIGHTS.fx * clamp(-data.fx/0.3,-1,1); score+=c; used+=WEIGHTS.fx; }
  if(data.vix!==null){ const c = WEIGHTS.vix * clamp(-data.vix/5,-1,1); score+=c; used+=WEIGHTS.vix; }

  const norm = used ? score/used : 0;
  drawGauge(norm);

  const verdictEl = document.getElementById('verdictText');
  const scoreEl = document.getElementById('scoreLine');
  scoreEl.textContent = `score ${norm>=0?'+':''}${norm.toFixed(2)}  ·  ${used.toFixed(1)}/${(WEIGHTS.gift+WEIGHTS.preopen+WEIGHTS.us+WEIGHTS.asia+WEIGHTS.fx+WEIGHTS.vix).toFixed(1)} weight available`;

  if(used===0){
    verdictEl.textContent = 'No data yet';
    verdictEl.className = 'verdict neutral';
  } else if(norm > 0.35){
    verdictEl.textContent = 'Bullish lean';
    verdictEl.className = 'verdict bull';
  } else if(norm < -0.35){
    verdictEl.textContent = 'Bearish lean';
    verdictEl.className = 'verdict bear';
  } else {
    verdictEl.textContent = 'Neutral / flat lean';
    verdictEl.className = 'verdict neutral';
  }
}

function drawGauge(norm){
  const svg = document.getElementById('gaugeSvg');
  const cx=110, cy=110, r=95;
  const angle = -180 + (clamp(norm,-1,1)+1)/2*180; // -180..0 deg
  const rad = angle * Math.PI/180;
  const nx = cx + r*0.82*Math.cos(rad);
  const ny = cy + r*0.82*Math.sin(rad);

  const arcColor = 'url(#gaugeGrad)';
  svg.innerHTML = `
    <defs>
      <linearGradient id="gaugeGrad" x1="0%" y1="0%" x2="100%" y2="0%">
        <stop offset="0%" stop-color="${getComputedStyle(document.documentElement).getPropertyValue('--bear')}"/>
        <stop offset="50%" stop-color="${getComputedStyle(document.documentElement).getPropertyValue('--gold')}"/>
        <stop offset="100%" stop-color="${getComputedStyle(document.documentElement).getPropertyValue('--bull')}"/>
      </linearGradient>
    </defs>
    <path d="M ${cx-r} ${cy} A ${r} ${r} 0 0 1 ${cx+r} ${cy}" fill="none" stroke="${arcColor}" stroke-width="10" stroke-linecap="round"/>
    <line x1="${cx}" y1="${cy}" x2="${nx}" y2="${ny}" stroke="#E8ECF4" stroke-width="3" stroke-linecap="round"/>
    <circle cx="${cx}" cy="${cy}" r="6" fill="#E8ECF4"/>
  `;
}

// ---------------- calculator ----------------
function fmtINR(n){
  const sign = n<0 ? '-' : '';
  return sign + '₹' + Math.abs(n).toLocaleString('en-IN',{maximumFractionDigits:0});
}

// Angel One's published NIFTYBEES (equity delivery ETF) charge schedule.
// Brokerage: 0.1% or ₹20 per order, whichever is lower, min ₹5.
// STT: 0.1% both legs. Exchange txn: ~0.00307%. SEBI + IPFT: ₹10/crore each.
// Stamp duty: 0.015% on buy only. DP charge: flat ₹23.60 (incl. GST) on sell only.
// GST 18% on (brokerage + exchange txn charges + SEBI fee + IPFT).
function angelOneCharges(buyValue, sellValue){
  function leg(value, isBuy){
    const brokerage = Math.min(0.001*value, 20) < 5 ? 5 : Math.min(0.001*value, 20);
    const stt = 0.001*value;
    const exchange = 0.0000307*value;
    const sebi = (10/1e7)*value;
    const ipft = (10/1e7)*value;
    const stamp = isBuy ? 0.00015*value : 0;
    const dp = isBuy ? 0 : 23.60;
    const gst = 0.18*(brokerage+exchange+sebi+ipft);
    return brokerage+stt+exchange+sebi+ipft+stamp+dp+gst;
  }
  return leg(buyValue, true) + leg(sellValue, false);
}

let calcMode = 'cash';
function setMode(mode){
  calcMode = mode;
  document.getElementById('mode-btn-cash').classList.toggle('active', mode==='cash');
  document.getElementById('mode-btn-mtf').classList.toggle('active', mode==='mtf');
  document.getElementById('mtf-only-fields').classList.toggle('show', mode==='mtf');
  document.getElementById('calc-disclaimer').textContent = mode==='mtf'
    ? 'MTF = Margin Trade Funding, exposure is 5\u00d7 your capital (broker funds the remaining 4\u00d7). Interest accrues daily on the borrowed 4\u00d7. Not investment advice.'
    : 'Cash (delivery) investing — no leverage, no interest, exposure equals what you put in. Not investment advice.';
  computeCalc();
}

function computeCalc(){
  const out = document.getElementById('calc-output');
  const summary = document.getElementById('calc-summary');
  const amount = parseFloat(document.getElementById('calc-amount').value);
  const movePct = parseFloat(document.getElementById('calc-move').value);
  const mtfRate = parseFloat(document.getElementById('calc-mtf-rate').value) || 0;
  const days = parseFloat(document.getElementById('calc-days').value) || 0;

  if(!amount || amount<=0 || isNaN(movePct)){
    out.innerHTML = '<div class="calc-empty">Enter an amount and an assumed % move to see results.</div>';
    summary.innerHTML = '';
    return;
  }

  function scenario(exposure, capital, direction, interest){
    const sellValue = exposure * (1 + direction*movePct/100);
    const fees = angelOneCharges(exposure, sellValue);
    const gross = sellValue - exposure;
    const net = gross - fees - interest;
    const netReturnOnCapital = (net / capital) * 100;
    return { fees, interest, gross, net, netReturnOnCapital };
  }

  let s, title, showInterest;
  if(calcMode === 'mtf'){
    const borrowed = amount*4;
    const mtfInterest = borrowed * (mtfRate/100) * (days/365);
    s = {
      exposure: amount*5, capital: amount, interest: mtfInterest,
      up: scenario(amount*5, amount, 1, mtfInterest),
      down: scenario(amount*5, amount, -1, mtfInterest),
    };
    title = 'MTF (5× leverage)';
    showInterest = true;
  } else {
    s = {
      exposure: amount, capital: amount, interest: 0,
      up: scenario(amount, amount, 1, 0),
      down: scenario(amount, amount, -1, 0),
    };
    title = 'Cash (delivery)';
    showInterest = false;
  }

  out.innerHTML = `
    <div class="calc-scenario">
      <div class="calc-scenario-title">${title} — exposure ${fmtINR(s.exposure)}, your capital ${fmtINR(s.capital)}</div>
      <div class="calc-grid">
        <div class="calc-col-head">If NIFTYBEES rises ${Math.abs(movePct)}%</div>
        <div class="calc-col-head">If NIFTYBEES falls ${Math.abs(movePct)}%</div>
        <div class="calc-line"><span class="lbl">Gross P&amp;L</span><span class="val ${s.up.gross>=0?'bull':'bear'}">${fmtINR(s.up.gross)}</span></div>
        <div class="calc-line"><span class="lbl">Gross P&amp;L</span><span class="val ${s.down.gross>=0?'bull':'bear'}">${fmtINR(s.down.gross)}</span></div>
        <div class="calc-line"><span class="lbl">Charges (brokerage+STT+GST etc.)</span><span class="val">-${fmtINR(s.up.fees)}</span></div>
        <div class="calc-line"><span class="lbl">Charges (brokerage+STT+GST etc.)</span><span class="val">-${fmtINR(s.down.fees)}</span></div>
        ${showInterest ? `
        <div class="calc-line"><span class="lbl">MTF interest (${days}d @ ${mtfRate}%)</span><span class="val">-${fmtINR(s.up.interest)}</span></div>
        <div class="calc-line"><span class="lbl">MTF interest (${days}d @ ${mtfRate}%)</span><span class="val">-${fmtINR(s.down.interest)}</span></div>` : ''}
        <div class="calc-line"><span class="lbl">Net P&amp;L</span><span class="val ${s.up.net>=0?'bull':'bear'}">${fmtINR(s.up.net)}</span></div>
        <div class="calc-line"><span class="lbl">Net P&amp;L</span><span class="val ${s.down.net>=0?'bull':'bear'}">${fmtINR(s.down.net)}</span></div>
        <div class="calc-line"><span class="lbl">Return on your capital</span><span class="val ${s.up.netReturnOnCapital>=0?'bull':'bear'}">${s.up.netReturnOnCapital>=0?'+':''}${s.up.netReturnOnCapital.toFixed(2)}%</span></div>
        <div class="calc-line"><span class="lbl">Return on your capital</span><span class="val ${s.down.netReturnOnCapital>=0?'bull':'bear'}">${s.down.netReturnOnCapital>=0?'+':''}${s.down.netReturnOnCapital.toFixed(2)}%</span></div>
      </div>
    </div>`;

  function summaryItem(label, net){
    const cls = net>=0 ? 'bull' : 'bear';
    return `<div class="summary-item">
      <div class="s-label">${label}</div>
      <div class="s-amount ${cls}">${net>=0?'+':''}${fmtINR(net)}</div>
    </div>`;
  }

  summary.innerHTML = `
    <div class="calc-summary-title">Net result on your ${fmtINR(amount)}</div>
    <div class="summary-grid">
      ${summaryItem(title+' · Up '+Math.abs(movePct)+'%', s.up.net)}
      ${summaryItem(title+' · Down '+Math.abs(movePct)+'%', s.down.net)}
    </div>`;
}

// ---------------- weight sliders ----------------
function buildSliders(){
  const wrap = document.getElementById('weightSliders');
  const labels = {gift:'GIFT Nifty gap', preopen:'NSE pre-open', us:'US markets', asia:'Asia markets', fx:'USD/INR', vix:'India VIX'};
  wrap.innerHTML = Object.keys(WEIGHTS).map(k=>`
    <div class="weight-row">
      <span>${labels[k]}</span>
      <span>
        <input type="range" min="0" max="4" step="0.1" value="${WEIGHTS[k]}" oninput="WEIGHTS['${k}']=parseFloat(this.value); this.nextElementSibling.textContent=this.value; computeScore();">
        <span style="font-family:Georgia,'Times New Roman',serif;font-size:11px;color:var(--muted);margin-left:6px;">${WEIGHTS[k]}</span>
      </span>
    </div>`).join('');
}

// ---------------- run all ----------------
async function runAll(){
  const btn = document.getElementById('refreshBtn');
  btn.disabled = true; btn.textContent = 'Fetching…';
  await Promise.allSettled([fetchNiftybeesPrice(), fetchGift(), fetchPreopen(), fetchVix(), fetchUS(), fetchAsia(), fetchFx()]);
  computeScore();
  document.getElementById('lastRun').textContent = 'Last run: ' + new Date().toLocaleString('en-IN', {hour:'2-digit',minute:'2-digit',day:'2-digit',month:'short'});
  btn.disabled = false; btn.textContent = 'Refresh all sources';
}

buildSliders();
drawGauge(0);
runAll();
</script>
