<title>NIFTYBEES Pre-Market</title>
<style>

:root{
  --bg:#0B1120;
  --surface:#121B30;
  --surface-2:#182543;
  --line:#233257;
  --gold:#D4A24C;
  --gold-dim:#8A6F3C;
  --bull:#3FB68B;
  --bear:#E2604F;
  --text:#E8ECF4;
  --muted:#7C8AA5;
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);}
body{
  font-family:Georgia,'Times New Roman',serif;
  padding:20px 16px 48px;
  max-width:520px;
  margin:0 auto;
  -webkit-font-smoothing:antialiased;
}
.header{
  display:flex;
  align-items:baseline;
  justify-content:space-between;
  margin-bottom:18px;
}
.brand{
  font-family:Georgia,'Times New Roman',serif;
  font-weight:600;
  font-size:22px;
  letter-spacing:-0.01em;
}
.brand span{color:var(--gold);}
.timestamp{
  font-family:Georgia,'Times New Roman',serif;
  font-size:11px;
  color:var(--muted);
}

/* ---- Price card ---- */
.price-card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:16px;
  padding:14px 18px;
  margin-bottom:14px;
}
.price-top{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
}
.price-value{
  font-family:Georgia,'Times New Roman',serif;
  font-weight:600;
  font-size:30px;
  margin-top:2px;
}
.price-change{text-align:right;}
.price-pct{
  font-family:Georgia,'Times New Roman',serif;
  font-size:14px;
  display:block;
  margin-top:4px;
}
.price-pct.bull{color:var(--bull);}
.price-pct.bear{color:var(--bear);}

/* ---- Gauge card ---- */
.gauge-card{
  background:linear-gradient(180deg,var(--surface),var(--surface-2));
  border:1px solid var(--line);
  border-radius:20px;
  padding:22px 20px 18px;
  margin-bottom:16px;
  text-align:center;
}
.gauge-wrap{position:relative;width:220px;height:120px;margin:0 auto 6px;}
.gauge-label{
  font-family:Georgia,'Times New Roman',serif;
  font-size:10px;
  letter-spacing:0.08em;
  color:var(--muted);
  text-transform:uppercase;
}
.verdict{
  font-family:Georgia,'Times New Roman',serif;
  font-weight:600;
  font-size:26px;
  margin:4px 0 2px;
}
.verdict.bull{color:var(--bull);}
.verdict.bear{color:var(--bear);}
.verdict.neutral{color:var(--gold);}
.score-line{
  font-family:Georgia,'Times New Roman',serif;
  font-size:12px;
  color:var(--muted);
}
.disclaimer{
  font-size:11px;
  color:var(--muted);
  margin-top:10px;
  line-height:1.5;
}

/* ---- Refresh button ---- */
.refresh-btn{
  width:100%;
  background:var(--gold);
  color:#1A1305;
  border:none;
  border-radius:12px;
  padding:13px;
  font-family:Georgia,'Times New Roman',serif;
  font-weight:600;
  font-size:14px;
  margin-bottom:18px;
  cursor:pointer;
}
.refresh-btn:active{opacity:0.85;}
.refresh-btn:disabled{opacity:0.5;}

/* ---- Source cards ---- */
.section-title{
  font-family:Georgia,'Times New Roman',serif;
  font-size:10px;
  letter-spacing:0.1em;
  text-transform:uppercase;
  color:var(--muted);
  margin:22px 0 8px 2px;
}
.card{
  background:var(--surface);
  border:1px solid var(--line);
  border-radius:14px;
  padding:14px 16px;
  margin-bottom:10px;
}
.card-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
.card-name{font-size:13px;font-weight:500;}
.badge{
  font-family:Georgia,'Times New Roman',serif;
  font-size:10px;
  padding:3px 8px;
  border-radius:20px;
  letter-spacing:0.03em;
}
.badge.live{background:rgba(63,182,139,0.15);color:var(--bull);}
.badge.failed{background:rgba(226,96,79,0.15);color:var(--bear);}
.badge.pending{background:rgba(124,138,165,0.15);color:var(--muted);}
.card-value{
  font-family:Georgia,'Times New Roman',serif;
  font-size:20px;
  margin-top:8px;
}
.card-value.bull{color:var(--bull);}
.card-value.bear{color:var(--bear);}
.card-sub{font-size:11px;color:var(--muted);margin-top:3px;}
.manual-row{margin-top:10px;display:flex;gap:8px;}
.manual-row input{
  flex:1;
  background:var(--surface-2);
  border:1px solid var(--line);
  border-radius:8px;
  color:var(--text);
  font-family:Georgia,'Times New Roman',serif;
  font-size:13px;
  padding:8px 10px;
}
.manual-row button{
