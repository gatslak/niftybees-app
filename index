}
.mtf-only{display:none;}
.mtf-only.show{display:block;}
.calc-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  margin-bottom:10px;
}
.calc-row label{font-size:12.5px;color:var(--muted);flex:1;}
.calc-row input{
  width:130px;
  background:var(--surface-2);
  border:1px solid var(--line);
  border-radius:8px;
  color:var(--text);
  font-family:Georgia,'Times New Roman',serif;
  font-size:14px;
  padding:8px 10px;
  text-align:right;
}
.calc-table{margin-top:14px;border-top:1px solid var(--line);padding-top:12px;}
.calc-empty{font-size:12px;color:var(--muted);}
.calc-scenario{margin-bottom:16px;}
.calc-scenario:last-child{margin-bottom:0;}
.calc-scenario-title{
  font-family:Georgia,'Times New Roman',serif;
  font-size:11px;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:8px;
}
.calc-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px 14px;
}
.calc-col-head{
  font-size:11px;
  color:var(--muted);
  border-bottom:1px solid var(--line);
  padding-bottom:4px;
}
.calc-line{
  display:flex;
  justify-content:space-between;
  font-size:12.5px;
  padding:3px 0;
}
.calc-line .lbl{color:var(--muted);}
.calc-line .val{font-family:Georgia,'Times New Roman',serif;}
.calc-line .val.bull{color:var(--bull);}
.calc-line .val.bear{color:var(--bear);}

.calc-summary{
  margin-top:16px;
  padding-top:14px;
  border-top:1px solid var(--line);
}
.calc-summary-title{
  font-family:Georgia,'Times New Roman',serif;
  font-size:11px;
  letter-spacing:0.05em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:10px;
}
.summary-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
}
.summary-item{
  background:var(--surface-2);
  border-radius:10px;
  padding:10px 12px;
}
.summary-item .s-label{
  font-size:11px;
  color:var(--muted);
  margin-bottom:4px;
}
.summary-item .s-amount{
  font-family:Georgia,'Times New Roman',serif;
  font-weight:600;
  font-size:18px;
}
.summary-item .s-amount.bull{color:var(--bull);}
.summary-item .s-amount.bear{color:var(--bear);}

/* weights */
details{margin-top:20px;}
summary{
  font-family:Georgia,'Times New Roman',serif;
  font-size:11px;
  color:var(--muted);
  cursor:pointer;
  letter-spacing:0.05em;
}
.weight-row{
  display:flex;
  align-items:center;
  justify-content:space-between;
  margin:10px 0;
  font-size:12px;
}
.weight-row input{width:110px;accent-color:var(--gold);}
</style>
